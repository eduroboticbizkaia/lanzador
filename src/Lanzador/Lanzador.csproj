<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <AssemblyName>Lanzador</AssemblyName>
    <RootNamespace>Lanzador</RootNamespace>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- La app no debe mostrar ninguna consola ni ventana al arrancar. -->
    <StartupObject>Lanzador.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="config.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\link.ico" Link="link.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
